{
  "name": "tjc-be-github-integration-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "oxlint src",
    "test": "vitest run",
    "contracts:generate": "node scripts/generate-contract-types.mjs",
    "contracts:check": "node scripts/generate-contract-types.mjs --check",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.2.1",
    "jose": "6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@12.14.0"
}
